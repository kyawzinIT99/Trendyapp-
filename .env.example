# ════════════════════════════════════════════════════════════════════════════
# TRENDY APP — All API Keys
# Copy to .env and fill in values as you get them
# ════════════════════════════════════════════════════════════════════════════

# ── FIREBASE (Google Sign-In + Cloud storage) ─────────────────────────────────
# Required for: Google Sign-In, cross-device cart/orders sync
# Get from: https://console.firebase.google.com → Project Settings → Web App
# Cost: FREE (50k reads + 20k writes/day)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── N8N (Order automation & notifications) ────────────────────────────────────
# Required for: orders, Google Sheet tracking, workflow automation
# Get from: your n8n instance → Webhooks node → copy Webhook URL
# Cost: FREE (self-hosted) or n8n.io cloud plan
VITE_N8N_WEBHOOK_URL=
# Dedicated webhook credential only. Never put an n8n management API key here.
VITE_N8N_WEBHOOK_TOKEN=

# ── STRIPE (International Visa/Mastercard payments) ───────────────────────────
# Required for: online card payments from international customers
# Get from: https://dashboard.stripe.com → Developers → API Keys
# Cost: FREE account — 2.9% + $0.30 per transaction (no monthly fee)
# NOTE: Use PUBLISHABLE key here (starts with pk_) — NEVER the secret key
VITE_STRIPE_PUBLISHABLE_KEY=

# ── MPU (Myanmar Payment Union — local card payments) ─────────────────────────
# Required for: Myanmar local bank card payments
# Get from: Contact MPU directly at https://www.mpu.com.mm
# Cost: Contact MPU for merchant rates
VITE_MPU_MERCHANT_ID=
VITE_MPU_GATEWAY_URL=

# ── GOOGLE CLIENT ID (Direct Google Sign-In — only if NOT using Firebase) ─────
# Leave blank if using Firebase Auth (recommended)
VITE_GOOGLE_CLIENT_ID=

# Trigger.dev server-side development configuration. Never prefix secrets with VITE_.
N8N_WEBHOOK_URL=
GOOGLE_SHEET_ID=
# Set TRIGGER_SECRET_KEY only in a local ignored .env or in the Trigger.dev dashboard.
